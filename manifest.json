{
  "manifest_version": 3,
  "name": "Thinking Duck",
  "description": "A lightweight Chrome extension that shows a moving duck with short speech bubbles.",
  "version": "0.1",
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "content/duck-style.js",
        "content/duck-movement.js",
        "content/duck-speech.js",
        "content/duck-init.js"
      ]
    }
  ]
}
